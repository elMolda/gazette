<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="{{ lang }}" lang="{{ lang }}">
<head>
  <title>{{ title | e }}</title>
  <link rel="stylesheet" type="text/css" href="../Styles/kindle.css"/>
</head>
<body>
  <h1>{{ title | e }}</h1>
  {% if meta_parts %}
  <p class="meta">{{ meta_parts | map('e') | join(' • ') }}</p>
  {% endif %}
  {{ body_html | safe }}
</body>
</html>
